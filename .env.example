HOST=127.0.0.1
PORT=3000

# OpenAI-compatible model. The project works offline without it (deterministic mode).
# Fill in your own key; any OpenAI-compatible endpoint works. Example for DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-<your key>
#   LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
