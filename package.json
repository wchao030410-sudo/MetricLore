{
  "name": "metriclore",
  "version": "0.2.0",
  "description": "Ontology-grounded agent for trustworthy metric answers and data analysis",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "health": "node scripts/health-check.mjs",
    "ingest": "node scripts/ingest.mjs raw/sample-metadata.md",
    "ingest:sql": "node scripts/ingest.mjs raw/sample-query.sql",
    "review": "node scripts/review-queue.mjs",
    "eval": "node scripts/run-evals.mjs",
    "eval:multi-turn": "node scripts/run-multi-turn-evals.mjs",
    "eval:wiki": "node scripts/run-wiki-evals.mjs",
    "verify": "npm test && npm run health && npm run eval && npm run eval:multi-turn && npm run eval:wiki && npm run audit && npm audit --omit=dev",
    "demo": "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "node-html-parser": "^9.0.1",
    "pdfjs-dist": "^6.2.108",
    "read-excel-file": "^9.3.10"
  }
}
